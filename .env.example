# Gmail account used to send contact-form notifications.
GMAIL_SMTP_USER=your-sender@gmail.com
# Create this in Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=your-16-character-app-password

# Contact backend used by the browser form.
NEXT_PUBLIC_CONTACT_API_URL=https://darkan-karate-backend-production.up.railway.app
